{
  "name": "docuextract",
  "version": "0.1.0",
  "description": "Official JavaScript/TypeScript SDK for the DocuExtract API — extract structured JSON from any document",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch"
  },
  "keywords": ["document", "extraction", "ocr", "invoice", "receipt", "ai", "pdf"],
  "author": "DocuExtract",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheOGSatoshiNakamoto/docuextract"
  },
  "homepage": "https://docuextract.dev/docs",
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
